{
  "$description": "Soundpass design tokens trich truc tiep tu frontend/src/styles.css (@theme). Co the dung de tao Figma Variables.",
  "brand": {
    "name": "Soundpass",
    "accent": "#e4572e"
  },
  "color": {
    "ink": {
      "950": "#0b121b",
      "900": "#101a26",
      "800": "#182430",
      "700": "#243342",
      "600": "#34506a"
    },
    "paper": {
      "DEFAULT": "#f7f5f0",
      "2": "#efece4",
      "line": "#e3ded2"
    },
    "accent": {
      "DEFAULT": "#e4572e",
      "dark": "#c44722",
      "soft": "#fbe9e1"
    },
    "success": { "DEFAULT": "#2f7d54", "soft": "#e7f3ec" },
    "warning": { "DEFAULT": "#a9761c", "soft": "#fbf1dd" },
    "danger": { "DEFAULT": "#b93b2f", "soft": "#fbe9e7" },
    "muted": { "DEFAULT": "#6b7280", "2": "#8b8f96" },
    "surface": { "card": "#ffffff", "seat": "#ffffff", "seatHeld": "#f6edcf", "seatSold": "#e7e3da" }
  },
  "font": {
    "display": { "family": "Manrope", "weights": [500, 600, 700, 800], "letterSpacing": "-0.02em" },
    "body": { "family": "DM Sans", "weights": [400, 500, 600, 700] },
    "size": {
      "xs": "12px",
      "sm": "13px / 14px",
      "base": "15px",
      "lg": "16px / 18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "28px / 30px",
      "5xl": "48px"
    }
  },
  "radius": {
    "card": "12px",
    "control": "8px",
    "chip": "8px",
    "badge": "4px",
    "seat": "5px"
  },
  "shadow": {
    "card": "0 1px 2px rgba(16,26,38,0.05), 0 10px 26px -18px rgba(16,26,38,0.35)",
    "pop": "0 18px 50px -22px rgba(11,18,27,0.55)",
    "focus": "0 0 0 3px rgba(228,87,46,0.14)"
  },
  "spacing": {
    "scale": ["4px", "8px", "12px", "16px", "20px", "24px", "32px", "40px", "48px", "64px"],
    "container": { "desktop": "1200px", "tablet": "834px", "mobile": "390px" },
    "gutter": { "desktop": "24px", "tablet": "20px", "mobile": "16px" }
  },
  "breakpoint": {
    "mobile": "390",
    "tablet": "834",
    "desktop": "1440"
  },
  "component": {
    "button": {
      "height": { "sm": "32px", "md": "40px", "lg": "44px" },
      "radius": "8px",
      "primary": { "bg": "#e4572e", "text": "#ffffff", "hover": "#c44722" },
      "secondary": { "bg": "#ffffff", "border": "#e3ded2", "text": "#101a26", "hoverBg": "#fbfaf7" },
      "danger": { "bg": "#b93b2f", "text": "#ffffff" },
      "dark": { "bg": "#101a26", "text": "#ffffff", "hover": "#182430" }
    },
    "input": {
      "height": "40px",
      "radius": "8px",
      "border": "#e3ded2",
      "bg": "#ffffff",
      "focusBorder": "#e4572e",
      "focusRing": "0 0 0 3px rgba(228,87,46,0.14)"
    },
    "card": { "bg": "#ffffff", "border": "#e3ded2", "radius": "12px", "shadow": "card" },
    "chip": { "radius": "8px", "border": "#e3ded2", "selectedBg": "#101a26", "selectedText": "#ffffff" },
    "badge": { "radius": "4px", "tones": ["accent", "success", "warning", "danger", "neutral"] },
    "table": { "headerBg": "#f7f5f0", "rowBorder": "#e3ded2", "radius": "12px" },
    "navbar": { "bg": "#0b121b", "text": "#f7f5f0", "height": "64px" },
    "sidebar": { "bg": "#0b121b", "width": "248px", "activeBg": "#182430", "activeAccent": "#e4572e" }
  }
}
