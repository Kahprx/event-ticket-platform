# Copy to backend/.env and replace the local development values.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_platform?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="1d"
PORT=5000
CLIENT_URL="http://localhost:5173,http://localhost:5174"
# Gmail SMTP — bật thông báo thanh toán. Dùng App Password, không dùng mật khẩu tài khoản.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-account@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="Soundpass <your-account@gmail.com>"
